{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/stage5/phase4/schema.json",
  "title": "Stage 5 Phase 4 split teaching layout contracts",
  "$ref": "#/$defs/presentation",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "bbox": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}
      ]
    },
    "semantic_role_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_field", "visual_role_id", "label", "visible_stage_indices", "causally_active_stage_indices"],
      "properties": {
        "semantic_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "visual_role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 28},
        "visible_stage_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "causally_active_stage_indices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "stage_presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_stage_index", "start_frame", "end_frame", "title", "caption"],
      "properties": {
        "semantic_stage_index": {"type": "integer", "minimum": 0},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1, "maxLength": 42},
        "caption": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "language", "layout_preset", "review_style_ids", "semantic_contract", "sequence_manifest", "legend", "stages"],
      "properties": {
        "schema_version": {"const": "stage5-phase4-presentation-4"},
        "phase": {"const": "phase4"},
        "language": {"const": "en"},
        "layout_preset": {"const": "split_annotation_caption_v2"},
        "review_style_ids": {
          "type": "array", "const": ["candidate-light-glass", "candidate-dark-glass"]
        },
        "semantic_contract": {"$ref": "#/$defs/artifact_ref"},
        "sequence_manifest": {"$ref": "#/$defs/artifact_ref"},
        "legend": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/semantic_role_binding"}},
        "stages": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/stage_presentation"}}
      }
    },
    "role_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_field", "visual_role_id", "label", "visible_stage_indices", "causally_active_stage_indices", "state_shape", "support_frames", "selected_rgb", "source_frame_index"],
      "properties": {
        "semantic_field": {"type": "string", "minLength": 1},
        "visual_role_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "visible_stage_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "causally_active_stage_indices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "state_shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "support_frames": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "selected_rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "source_frame_index": {"type": "integer", "minimum": 0}
      }
    },
    "stage_overlay_layout": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_stage_index", "annotation_region", "title_region", "legend_region", "caption_region", "visible_visual_role_ids", "annotation_width", "annotation_height", "caption_width", "caption_height", "title_line_count", "caption_line_count", "adaptive_compaction"],
      "properties": {
        "semantic_stage_index": {"type": "integer", "minimum": 0},
        "annotation_region": {"$ref": "#/$defs/bbox"},
        "title_region": {"$ref": "#/$defs/bbox"},
        "legend_region": {"$ref": "#/$defs/bbox"},
        "caption_region": {"$ref": "#/$defs/bbox"},
        "visible_visual_role_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "annotation_width": {"type": "integer", "minimum": 350, "maximum": 410},
        "annotation_height": {"type": "integer", "minimum": 1, "maximum": 150},
        "caption_width": {"type": "integer", "minimum": 1, "maximum": 760},
        "caption_height": {"type": "integer", "minimum": 1, "maximum": 60},
        "title_line_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "caption_line_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "adaptive_compaction": {"type": "boolean"}
      }
    },
    "critical_overlap": {
      "type": "object", "additionalProperties": false,
      "required": ["critical_pixel_count", "annotation_critical_pixels", "caption_critical_pixels", "annotation_coverage_ratio", "caption_coverage_ratio"],
      "properties": {
        "critical_pixel_count": {"type": "integer", "minimum": 1},
        "annotation_critical_pixels": {"type": "integer", "minimum": 0},
        "caption_critical_pixels": {"type": "integer", "minimum": 0},
        "annotation_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 0.03},
        "caption_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 0.02}
      }
    },
    "teaching_frame_record": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_index", "artifact", "stage_index", "visible_visual_role_ids", "mechanism_rgb_sha256", "annotation_region", "caption_region", "annotation_rgb_sha256", "caption_rgb_sha256", "critical_overlap", "width", "height", "mode"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "artifact": {"$ref": "#/$defs/artifact_ref"},
        "stage_index": {"type": "integer", "minimum": 0},
        "visible_visual_role_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mechanism_rgb_sha256": {"$ref": "#/$defs/sha256"},
        "annotation_region": {"$ref": "#/$defs/bbox"},
        "caption_region": {"$ref": "#/$defs/bbox"},
        "annotation_rgb_sha256": {"$ref": "#/$defs/sha256"},
        "caption_rgb_sha256": {"$ref": "#/$defs/sha256"},
        "critical_overlap": {"$ref": "#/$defs/critical_overlap"},
        "width": {"const": 880}, "height": {"const": 600}, "mode": {"const": "RGB"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "passed", "evidence"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "passed": {"const": true},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "style_parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["style_id", "backing_alpha", "caption_backing_alpha", "annotation_fill_rgba", "caption_fill_rgba", "title_rgb", "body_rgb", "border_rgb", "corner_radius", "blur_used"],
      "properties": {
        "style_id": {"enum": ["candidate-light-glass", "candidate-dark-glass"]},
        "backing_alpha": {"type": "number", "minimum": 0.30, "maximum": 0.50},
        "caption_backing_alpha": {"type": "number", "minimum": 0.30, "maximum": 0.50},
        "annotation_fill_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "caption_fill_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "title_rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "body_rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "border_rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
        "corner_radius": {"type": "integer", "minimum": 0, "maximum": 4},
        "blur_used": {"const": false}
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "presentation", "style_ids", "recommendation", "evidence", "human_review_status"],
      "properties": {
        "schema_version": {"const": "stage5-phase4-layout-recommendation-2"},
        "phase": {"const": "phase4"},
        "presentation": {"$ref": "#/$defs/artifact_ref"},
        "style_ids": {"type": "array", "const": ["candidate-light-glass", "candidate-dark-glass"]},
        "recommendation": {"enum": ["accept_both_for_human_comparison", "revise_both", "reject_both"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "human_review_status": {"const": "pending_human_review"}
      }
    },
    "human_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "status", "presentation", "selected_style_id", "notes"],
      "properties": {
        "schema_version": {"const": "stage5-phase4-layout-human-decision-2"},
        "phase": {"const": "phase4"},
        "status": {"enum": ["approved", "rejected"]},
        "presentation": {"$ref": "#/$defs/artifact_ref"},
        "selected_style_id": {"enum": ["candidate-light-glass", "candidate-dark-glass", "none"]},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "teaching_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "phase", "semantic_contract", "sequence_manifest", "sequence_archive", "source_presentation", "presentation", "renderer", "timeline", "layout", "frames", "legend_bindings", "layout_checks", "deterministic_replay", "checks", "human_review_status", "status"],
      "properties": {
        "schema_version": {"const": "stage5-phase4-teaching-manifest-4"},
        "artifact_type": {"const": "teaching_sequence"}, "phase": {"const": "phase4"},
        "semantic_contract": {"$ref": "#/$defs/artifact_ref"},
        "sequence_manifest": {"$ref": "#/$defs/artifact_ref"},
        "sequence_archive": {"$ref": "#/$defs/artifact_ref"},
        "source_presentation": {"$ref": "#/$defs/artifact_ref"},
        "presentation": {"$ref": "#/$defs/artifact_ref"},
        "renderer": {
          "type": "object", "additionalProperties": false,
          "required": ["adapter", "state_source", "prototype", "runtime_sha256"],
          "properties": {
            "adapter": {"enum": ["frozen_public_semantic_probe_v1", "generic_semantic_field_v1"]},
            "state_source": {"const": "saved_phase3_sequence_only"},
            "prototype": {"$ref": "#/$defs/artifact_ref"},
            "runtime_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "timeline": {
          "type": "object", "additionalProperties": false,
          "required": ["frame_count", "fps", "duration_seconds", "stage_count"],
          "properties": {
            "frame_count": {"type": "integer", "minimum": 1}, "fps": {"type": "number", "exclusiveMinimum": 0},
            "duration_seconds": {"type": "number", "exclusiveMinimum": 0}, "stage_count": {"type": "integer", "minimum": 2, "maximum": 6}
          }
        },
        "layout": {
          "type": "object", "additionalProperties": false,
          "required": ["preset_id", "style_id", "style_parameters", "output_width", "output_height", "mechanism_viewport", "annotation_anchor", "annotation_width_range", "annotation_max_height", "caption_placement", "critical_overlap_thresholds", "max_observed_annotation_coverage_ratio", "max_observed_caption_coverage_ratio", "stage_layouts"],
          "properties": {
            "preset_id": {"const": "split_annotation_caption_v2"},
            "style_id": {"enum": ["candidate-light-glass", "candidate-dark-glass"]},
            "style_parameters": {"$ref": "#/$defs/style_parameters"},
            "output_width": {"const": 880}, "output_height": {"const": 600},
            "mechanism_viewport": {"type": "array", "const": [0, 0, 880, 600]},
            "annotation_anchor": {"const": "top_left"},
            "annotation_width_range": {"type": "array", "const": [350, 410]},
            "annotation_max_height": {"const": 150},
            "caption_placement": {"const": "bottom_center_content_sized"},
            "critical_overlap_thresholds": {
              "type": "object", "additionalProperties": false,
              "required": ["annotation", "caption"],
              "properties": {"annotation": {"const": 0.03}, "caption": {"const": 0.02}}
            },
            "max_observed_annotation_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 0.03},
            "max_observed_caption_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 0.02},
            "stage_layouts": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/stage_overlay_layout"}}
          }
        },
        "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/teaching_frame_record"}},
        "legend_bindings": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/role_evidence"}},
        "layout_checks": {
          "type": "object", "additionalProperties": false,
          "required": ["canvas_is_880x600", "no_sidecar", "no_opaque_white_panel", "annotation_caption_separate", "annotation_bounds", "caption_bounds", "text_fits", "readable_minimum_fonts", "stage_specific_legend", "no_empty_legend_rows", "copy_matches_presentation", "critical_overlap_within_thresholds"],
          "properties": {
            "canvas_is_880x600": {"const": true}, "no_sidecar": {"const": true}, "no_opaque_white_panel": {"const": true},
            "annotation_caption_separate": {"const": true}, "annotation_bounds": {"const": true}, "caption_bounds": {"const": true},
            "text_fits": {"const": true}, "readable_minimum_fonts": {"const": true}, "stage_specific_legend": {"const": true},
            "no_empty_legend_rows": {"const": true}, "copy_matches_presentation": {"const": true}, "critical_overlap_within_thresholds": {"const": true}
          }
        },
        "deterministic_replay": {
          "type": "object", "additionalProperties": false,
          "required": ["algorithm", "first_digest", "second_digest", "matched"],
          "properties": {
            "algorithm": {"const": "sha256-frame-index-rgb-bytes-v1"},
            "first_digest": {"$ref": "#/$defs/sha256"}, "second_digest": {"$ref": "#/$defs/sha256"}, "matched": {"const": true}
          }
        },
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "human_review_status": {"const": "pending_human_review"}, "status": {"const": "complete"}
      }
    }
  }
}
