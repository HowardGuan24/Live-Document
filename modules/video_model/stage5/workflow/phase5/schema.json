{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/stage5/phase5/schema.json",
  "title": "Stage 5 Phase 5 governed appearance contracts",
  "$ref": "#/$defs/appearance_plan",
  "$defs": {
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "bbox": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}
      ]
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "passed", "evidence"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "passed": {"type": "boolean"},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "probe_selection": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "frame_index", "semantic_milestone", "required_role_ids"],
      "properties": {
        "probe_id": {"type": "string", "pattern": "^probe-[a-z0-9_-]+$"},
        "frame_index": {"type": "integer", "minimum": 0},
        "semantic_milestone": {"type": "string", "minLength": 1},
        "required_role_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}}
      }
    },
    "role_treatment": {
      "type": "object", "additionalProperties": false,
      "required": ["visual_role_id", "semantic_fields", "treatment_type", "mapping_rule", "geometry_authority"],
      "properties": {
        "visual_role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "semantic_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
        "treatment_type": {"enum": ["local_generated_material", "deterministic_shader", "fixed_semantic_color", "copied_overlay"]},
        "material_class_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "mapping_rule": {"type": "string", "minLength": 1},
        "geometry_authority": {"const": "phase3_semantic_masks"}
      },
      "allOf": [{
        "if": {"properties": {"treatment_type": {"const": "local_generated_material"}}, "required": ["treatment_type"]},
        "then": {"required": ["material_class_id"]},
        "else": {"not": {"required": ["material_class_id"]}}
      }]
    },
    "generation_job": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "material_class_id", "candidate_asset_id", "prompt", "negative_prompt", "seed", "width", "height", "steps", "guidance_scale"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^job-[a-z0-9_-]+$"},
        "material_class_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "candidate_asset_id": {"type": "string", "pattern": "^asset-[a-z0-9_-]+$"},
        "prompt": {"type": "string", "minLength": 1},
        "negative_prompt": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 256, "maximum": 1024, "multipleOf": 8},
        "height": {"type": "integer", "minimum": 256, "maximum": 1024, "multipleOf": 8},
        "steps": {"type": "integer", "minimum": 1, "maximum": 60},
        "guidance_scale": {"type": "number", "minimum": 0, "maximum": 20}
      }
    },
    "candidate_config": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "material_asset_ids", "limestone_opacity", "weathered_opacity"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^(baseline|candidate-[0-9]{3})$"},
        "material_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^asset-[a-z0-9_-]+$"}},
        "limestone_opacity": {"type": "number", "minimum": 0, "maximum": 0.45},
        "weathered_opacity": {"type": "number", "minimum": 0, "maximum": 0.35}
      }
    },
    "appearance_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "product_path_status", "execution_profile", "sources", "output_constraints", "probe_selections", "role_treatments", "local_generation", "candidate_configs", "composition", "status"],
      "properties": {
        "schema_version": {"const": "stage5-phase5-appearance-plan-2"},
        "phase": {"const": "phase5"},
        "product_path_status": {"const": "mandatory"},
        "execution_profile": {"enum": ["product_local_model", "fixture_placeholder"]},
        "sources": {
          "type": "object", "additionalProperties": false,
          "required": ["semantic_contract", "sequence_archive", "sequence_manifest", "presentation", "teaching_manifest"],
          "properties": {
            "semantic_contract": {"$ref": "#/$defs/artifact_ref"},
            "sequence_archive": {"$ref": "#/$defs/artifact_ref"},
            "sequence_manifest": {"$ref": "#/$defs/artifact_ref"},
            "presentation": {"$ref": "#/$defs/artifact_ref"},
            "teaching_manifest": {"$ref": "#/$defs/artifact_ref"}
          }
        },
        "output_constraints": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "protected_mechanism_viewport", "protected_overlay_policy", "model_text_allowed"],
          "properties": {
            "width": {"const": 880}, "height": {"const": 600},
            "protected_mechanism_viewport": {"const": [0, 0, 880, 600]},
            "protected_overlay_policy": {"const": "restore_exact_phase4_overlay_pixels"},
            "model_text_allowed": {"const": false}
          }
        },
        "probe_selections": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/probe_selection"}},
        "role_treatments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role_treatment"}},
        "local_generation": {
          "type": "object", "additionalProperties": false,
          "required": ["required", "network_allowed", "model_family", "model_root", "model_inventory", "runtime_python", "jobs", "max_material_classes", "max_candidates_per_class", "max_images", "frozen_before_execution", "resampling_after_inspection"],
          "properties": {
            "required": {"const": true}, "network_allowed": {"const": false},
            "model_family": {"type": "string", "minLength": 1},
            "model_root": {"type": "string", "minLength": 1},
            "model_inventory": {"$ref": "#/$defs/artifact_ref"},
            "runtime_python": {"type": "string", "minLength": 1},
            "jobs": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/generation_job"}},
            "max_material_classes": {"type": "integer", "minimum": 1, "maximum": 2},
            "max_candidates_per_class": {"type": "integer", "minimum": 1, "maximum": 2},
            "max_images": {"type": "integer", "minimum": 1, "maximum": 4},
            "frozen_before_execution": {"const": true},
            "resampling_after_inspection": {"const": false}
          }
        },
        "candidate_configs": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate_config"}},
        "composition": {
          "type": "object", "additionalProperties": false,
          "required": ["geometry_authority", "mask_resampling", "generated_material_scope", "dynamic_water_policy", "overlay_policy", "layer_order", "plan_mutation_after_execution"],
          "properties": {
            "geometry_authority": {"const": "phase3_semantic_masks"},
            "mask_resampling": {"const": "nearest_neighbor"},
            "generated_material_scope": {"const": "authoritative_masks_only"},
            "dynamic_water_policy": {"const": "deterministic_phase4_semantics_only"},
            "overlay_policy": {"const": "restore_exact_phase4_overlay_pixels"},
            "layer_order": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
            "plan_mutation_after_execution": {"const": false}
          }
        },
        "status": {"const": "frozen_before_execution"}
      }
    },
    "executed_job": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "material_class_id", "candidate_asset_id", "prompt", "negative_prompt", "seed", "parameters", "model_sha256", "asset", "elapsed_seconds", "adapter"],
      "properties": {
        "job_id": {"type": "string"}, "material_class_id": {"type": "string"}, "candidate_asset_id": {"type": "string"},
        "prompt": {"type": "string"}, "negative_prompt": {"type": "string"}, "seed": {"type": "integer"},
        "parameters": {"type": "object"}, "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "asset": {"$ref": "#/$defs/artifact_ref"}, "elapsed_seconds": {"type": "number", "minimum": 0},
        "adapter": {"enum": ["local_sdxl_diffusers", "fixture_placeholder"]}
      }
    },
    "probe_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "frame_index", "artifact", "overlay_bbox", "overlay_sha256", "semantic_mask_sha256", "topology_sha256"],
      "properties": {
        "probe_id": {"type": "string"}, "frame_index": {"type": "integer"}, "artifact": {"$ref": "#/$defs/artifact_ref"},
        "overlay_bbox": {"$ref": "#/$defs/bbox"}, "overlay_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "semantic_mask_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "topology_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "prominence_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "mechanism_bbox_occupancy", "active_contrast", "overlay_to_mechanism_visual_weight", "texture_competition", "normal_size_mechanism_noticeable"],
      "properties": {
        "candidate_id": {"type": "string"},
        "mechanism_bbox_occupancy": {"type": "number", "minimum": 0, "maximum": 1},
        "active_contrast": {"type": "number", "minimum": 0},
        "overlay_to_mechanism_visual_weight": {"type": "number", "minimum": 0},
        "texture_competition": {"type": "number", "minimum": 0},
        "normal_size_mechanism_noticeable": {"type": "boolean"}
      }
    },
    "appearance_execution": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "appearance_plan", "execution_profile", "network_used", "model", "jobs", "candidates", "prominence_metrics", "checks", "deterministic_replay", "status"],
      "properties": {
        "schema_version": {"const": "stage5-phase5-appearance-execution-2"}, "phase": {"const": "phase5"},
        "appearance_plan": {"$ref": "#/$defs/artifact_ref"}, "execution_profile": {"enum": ["product_local_model", "fixture_placeholder"]},
        "network_used": {"const": false},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["family", "root_path", "inventory", "primary_weight_sha256", "runtime_python", "local_files_only"],
          "properties": {
            "family": {"type": "string"}, "root_path": {"type": "string"}, "inventory": {"$ref": "#/$defs/artifact_ref"},
            "primary_weight_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "runtime_python": {"type": "string"}, "local_files_only": {"const": true}
          }
        },
        "jobs": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/executed_job"}},
        "candidates": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["candidate_id", "material_asset_ids", "probes"],
            "properties": {
              "candidate_id": {"type": "string"}, "material_asset_ids": {"type": "array", "items": {"type": "string"}},
              "probes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/probe_artifact"}}
            }
          }
        },
        "prominence_metrics": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/prominence_metrics"}},
        "checks": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/check"}},
        "deterministic_replay": {
          "type": "object", "additionalProperties": false, "required": ["matched", "first_digest", "second_digest"],
          "properties": {"matched": {"const": true}, "first_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "second_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        },
        "status": {"const": "complete_pending_agent_review"}
      }
    },
    "candidate_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "appearance_plausibility", "semantic_preservation", "subject_prominence", "pattern_risk", "overlay_integrity", "appearance_utility", "evidence"],
      "properties": {
        "candidate_id": {"type": "string"},
        "appearance_plausibility": {"enum": ["passed", "warning", "failed"]},
        "semantic_preservation": {"enum": ["passed", "failed"]},
        "subject_prominence": {"enum": ["passed", "warning", "failed"]},
        "pattern_risk": {"enum": ["low", "moderate", "high"]},
        "overlay_integrity": {"enum": ["passed", "failed"]},
        "appearance_utility": {"enum": ["useful", "limited", "regression"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "appearance_review": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "appearance_plan", "appearance_execution", "candidate_assessments", "recommendation", "recommended_candidate_ids", "warnings", "status"],
      "properties": {
        "schema_version": {"const": "stage5-phase5-appearance-review-2"}, "phase": {"const": "phase5"},
        "appearance_plan": {"$ref": "#/$defs/artifact_ref"}, "appearance_execution": {"$ref": "#/$defs/artifact_ref"},
        "candidate_assessments": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/candidate_assessment"}},
        "recommendation": {"enum": ["accept", "accept_with_warnings", "reject"]},
        "recommended_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"const": "pending_human_review"}
      }
    },
    "human_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "appearance_plan", "appearance_execution", "appearance_review", "decision", "selected_candidate_ids", "reviewer", "decided_at"],
      "properties": {
        "schema_version": {"const": "stage5-phase5-human-decision-1"}, "phase": {"const": "phase5"},
        "appearance_plan": {"$ref": "#/$defs/artifact_ref"}, "appearance_execution": {"$ref": "#/$defs/artifact_ref"}, "appearance_review": {"$ref": "#/$defs/artifact_ref"},
        "decision": {"enum": ["approved", "rejected"]},
        "selected_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reviewer": {"type": "string", "minLength": 1}, "decided_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [{
        "if": {"properties": {"decision": {"const": "approved"}}, "required": ["decision"]},
        "then": {"properties": {"selected_candidate_ids": {"minItems": 1}}},
        "else": {"properties": {"selected_candidate_ids": {"maxItems": 0}}}
      }]
    },
    "appearance_pack": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "phase", "appearance_plan", "appearance_execution", "appearance_review", "human_decision", "selected_candidate_ids", "selected_assets", "status"],
      "properties": {
        "schema_version": {"const": "stage5-phase5-appearance-pack-2"}, "phase": {"const": "phase5"},
        "appearance_plan": {"$ref": "#/$defs/artifact_ref"}, "appearance_execution": {"$ref": "#/$defs/artifact_ref"},
        "appearance_review": {"$ref": "#/$defs/artifact_ref"}, "human_decision": {"$ref": "#/$defs/artifact_ref"},
        "selected_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "selected_assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
        "status": {"const": "approved_for_phase6"}
      }
    }
  }
}
