{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/schemas/phase1-semantic-contract.schema.json",
  "title": "Live Document Phase 1 Semantic Contract",
  "description": "Defines the observable semantic truths that every later implementation must preserve. It must not contain program-specific geometry, arrays, numeric simulation parameters, rendering decisions, or model prompts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scoped_concept",
    "duration_seconds",
    "entities",
    "stages",
    "progress_variables",
    "temporal_constraints",
    "spatial_constraints",
    "required_visual_evidence",
    "forbidden_visual_interpretations",
    "authority_boundaries"
  ],
  "properties": {
    "scoped_concept": {
      "type": "string",
      "minLength": 1,
      "description": "Copied from the approved Phase 0 scope."
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 8,
      "maximum": 12,
      "multipleOf": 0.5,
      "description": "Copied from the approved Phase 0 scope."
    },
    "entities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "persistence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "The entity's conceptual role in the explanation."
          },
          "persistence": {
            "type": "string",
            "minLength": 1,
            "description": "How the entity persists, appears, transforms, or emerges across the explanation."
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cause",
          "visible_change",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cause": {
            "type": "string",
            "minLength": 1,
            "description": "What makes this stage happen."
          },
          "visible_change": {
            "type": "string",
            "minLength": 1,
            "description": "What must visibly change in the animation. This is not a shot description or implementation method."
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "description": "The semantic state produced by the stage."
          }
        }
      }
    },
    "progress_variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "meaning",
          "behavior"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "An abstract semantic progress name, not a program variable with a fixed representation."
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "description": "Qualitative behavior such as gradual increase, completion, or persistence. Do not specify numeric rates or thresholds."
          }
        }
      }
    },
    "temporal_constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spatial_constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_visual_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Observable evidence that must appear in the animation itself, not only in captions."
    },
    "forbidden_visual_interpretations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "appearance_model",
        "text"
      ],
      "properties": {
        "program": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appearance_model": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
