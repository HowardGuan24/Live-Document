{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/schemas/program-baseline.schema.json",
  "title": "Live Document Program Baseline Schemas",
  "$comment": "Use #/$defs/schedule, #/$defs/sequence_manifest, or #/$defs/program_manifest.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "progress_values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "progress_values"],
      "properties": {
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "progress_values": {"$ref": "#/$defs/progress_values"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_anchor", "to_anchor", "transition_frames", "easing"],
      "properties": {
        "from_anchor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "to_anchor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "transition_frames": {"type": "integer", "minimum": 1},
        "easing": {"type": "string", "enum": ["linear", "smoothstep"]}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "fps",
        "frame_count",
        "start_hold_frames",
        "anchors",
        "segments",
        "end_hold_frames"
      ],
      "properties": {
        "duration_seconds": {"const": 10},
        "fps": {"const": 12},
        "frame_count": {"const": 120},
        "start_hold_frames": {"type": "integer", "minimum": 0},
        "anchors": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/segment"}
        },
        "end_hold_frames": {"type": "integer", "minimum": 0}
      }
    },
    "factual_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "passed", "evidence"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "passed": {"const": true},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "workflow_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_class", "message", "return_target"],
      "properties": {
        "failure_class": {
          "type": "string",
          "enum": [
            "compatibility_failure",
            "schedule_failure",
            "sequence_generation_failure",
            "semantic_invariant_failure",
            "program_render_failure",
            "encoding_failure",
            "presentation_copy_failure",
            "presentation_layout_failure"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "return_target": {
          "type": "string",
          "enum": [
            "scheduler",
            "program_baseline_runtime",
            "frozen_implementation",
            "program_renderer",
            "encoder",
            "presentation_agent",
            "presentation_compositor"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "python_version",
        "platform",
        "cwd",
        "packages"
      ],
      "properties": {
        "interpreter": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1},
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "argv",
        "exit_code",
        "elapsed_seconds",
        "started_at_utc",
        "finished_at_utc",
        "environment"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "exit_code": {"const": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "finished_at_utc": {"type": "string", "format": "date-time"},
        "environment": {"$ref": "#/$defs/environment"}
      }
    },
    "field_description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "dtype",
        "state_shape",
        "archive_shape",
        "consumers"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "kind": {"type": "string", "enum": ["authoritative", "derived"]},
        "dtype": {"type": "string", "minLength": 1},
        "state_shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "archive_shape": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime_field_description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape", "meaning"],
      "properties": {
        "name": {"type": "string", "pattern": "^__runtime_[A-Za-z0-9_]+$"},
        "dtype": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "anchor_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_anchor", "to_anchor"],
      "properties": {
        "from_anchor": {"type": "string", "minLength": 1},
        "to_anchor": {"type": "string", "minLength": 1}
      }
    },
    "frame_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index",
        "frame_id",
        "presentation_time_seconds",
        "semantic_normalized_time",
        "source_anchor_interval",
        "interpolation_value",
        "progress_values"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 119},
        "frame_id": {"type": "string", "pattern": "^frame-[0-9]{6}$"},
        "presentation_time_seconds": {"type": "number", "minimum": 0},
        "semantic_normalized_time": {"type": "number", "minimum": 0, "maximum": 1},
        "source_anchor_interval": {"$ref": "#/$defs/anchor_interval"},
        "interpolation_value": {"type": "number", "minimum": 0, "maximum": 1},
        "progress_values": {"$ref": "#/$defs/progress_values"}
      }
    },
    "invariant_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "claim", "passed", "evidence"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "claim": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "evidence": {"type": "string", "minLength": 1},
        "observed_count": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "state_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rendered": {"type": "boolean"},
        "sample_id": {"type": ["string", "null"]},
        "worst_sample_id": {"type": ["string", "null"]},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "compatibility_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_binding_rule",
        "prototype_resolution_rule",
        "resolved_prototype_repository_path"
      ],
      "properties": {
        "plan_binding_rule": {"const": "legacy_cross_checked_sibling_v1"},
        "prototype_resolution_rule": {
          "type": "string",
          "enum": [
            "executable_spec_absolute_verified_v1",
            "plan_repository_relative_verified_v1"
          ]
        },
        "resolved_prototype_repository_path": {
          "type": "string",
          "pattern": "^modules/video_model/stage5/.+"
        }
      }
    },
    "sequence_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "created_at_utc",
        "inputs",
        "compatibility_resolution",
        "frozen_config",
        "schedule",
        "frame_count",
        "fps",
        "duration_seconds",
        "sequence_archive",
        "semantic_fields",
        "runtime_metadata_fields",
        "frames",
        "full_sequence_invariants",
        "deterministic_replay",
        "checks",
        "failures",
        "execution"
      ],
      "properties": {
        "schema_version": {"const": "program-baseline-1"},
        "artifact_type": {"const": "sequence_manifest"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable_spec",
            "semantic_contract",
            "supplemental_plan",
            "source_probe_result",
            "source_selection",
            "resolved_prototype"
          ],
          "properties": {
            "executable_spec": {"$ref": "#/$defs/artifact_ref"},
            "semantic_contract": {"$ref": "#/$defs/artifact_ref"},
            "supplemental_plan": {"$ref": "#/$defs/artifact_ref"},
            "source_probe_result": {"$ref": "#/$defs/artifact_ref"},
            "source_selection": {"$ref": "#/$defs/artifact_ref"},
            "resolved_prototype": {"$ref": "#/$defs/artifact_ref"}
          }
        },
        "compatibility_resolution": {"$ref": "#/$defs/compatibility_resolution"},
        "frozen_config": {"type": "object", "minProperties": 1},
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "resolved"],
          "properties": {
            "artifact": {"$ref": "#/$defs/artifact_ref"},
            "resolved": {"$ref": "#/$defs/schedule"}
          }
        },
        "frame_count": {"const": 120},
        "fps": {"const": 12},
        "duration_seconds": {"const": 10},
        "sequence_archive": {"$ref": "#/$defs/artifact_ref"},
        "semantic_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/field_description"}
        },
        "runtime_metadata_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/runtime_field_description"}
        },
        "frames": {
          "type": "array",
          "minItems": 120,
          "maxItems": 120,
          "items": {"$ref": "#/$defs/frame_record"}
        },
        "full_sequence_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/invariant_result"}
        },
        "deterministic_replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "first_digest", "second_digest", "matched"],
          "properties": {
            "algorithm": {"const": "sha256-field-name-dtype-shape-c-bytes-v1"},
            "first_digest": {"$ref": "#/$defs/sha256"},
            "second_digest": {"$ref": "#/$defs/sha256"},
            "matched": {"const": true}
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/factual_check"}
        },
        "failures": {
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/workflow_failure"}
        },
        "execution": {"$ref": "#/$defs/execution"}
      }
    },
    "frame_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "frame_id", "artifact", "width", "height", "mode"],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0, "maximum": 119},
        "frame_id": {"type": "string", "pattern": "^frame-[0-9]{6}$"},
        "artifact": {"$ref": "#/$defs/artifact_ref"},
        "width": {"const": 880},
        "height": {"const": 600},
        "mode": {"const": "RGB"}
      }
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "program_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "created_at_utc",
        "sequence_manifest",
        "sequence_archive",
        "prototype",
        "renderer_adapter",
        "dimensions",
        "frames",
        "contact_sheet",
        "media_tools",
        "encoding",
        "program_preview",
        "media_inspection",
        "checks",
        "failures",
        "execution"
      ],
      "properties": {
        "schema_version": {"const": "program-baseline-1"},
        "artifact_type": {"const": "program_manifest"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "sequence_manifest": {"$ref": "#/$defs/artifact_ref"},
        "sequence_archive": {"$ref": "#/$defs/artifact_ref"},
        "prototype": {"$ref": "#/$defs/artifact_ref"},
        "renderer_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "runtime", "public_callable", "invocation", "state_source"],
          "properties": {
            "name": {"const": "single_state_render_program_probe_v1"},
            "runtime": {"$ref": "#/$defs/artifact_ref"},
            "public_callable": {"const": "render_program_probe"},
            "invocation": {"const": "render_program_probe([state], native_output_path)"},
            "state_source": {"const": "saved_sequence_only"}
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["native_width", "native_height", "output_width", "output_height", "scale_factor", "scaling_mode"],
          "properties": {
            "native_width": {"const": 220},
            "native_height": {"const": 150},
            "output_width": {"const": 880},
            "output_height": {"const": 600},
            "scale_factor": {"const": 4},
            "scaling_mode": {"const": "nearest_neighbor_integer_4x"}
          }
        },
        "frames": {
          "type": "array",
          "minItems": 120,
          "maxItems": 120,
          "items": {"$ref": "#/$defs/frame_artifact"}
        },
        "contact_sheet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "frame_indices"],
          "properties": {
            "artifact": {"$ref": "#/$defs/artifact_ref"},
            "frame_indices": {
              "type": "array",
              "minItems": 7,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0, "maximum": 119}
            }
          }
        },
        "media_tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ffmpeg", "ffprobe"],
          "properties": {
            "ffmpeg": {"$ref": "#/$defs/tool_identity"},
            "ffprobe": {"$ref": "#/$defs/tool_identity"}
          }
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "argv", "input_fps", "frame_count", "codec", "pixel_format", "preset", "crf", "audio", "frame_interpolation", "implicit_duplication"],
          "properties": {
            "command": {"type": "string", "minLength": 1},
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "input_fps": {"const": 12},
            "frame_count": {"const": 120},
            "codec": {"const": "libx264"},
            "pixel_format": {"const": "yuv420p"},
            "preset": {"type": "string", "minLength": 1},
            "crf": {"type": "integer", "minimum": 0, "maximum": 51},
            "audio": {"const": false},
            "frame_interpolation": {"const": false},
            "implicit_duplication": {"const": false}
          }
        },
        "program_preview": {"$ref": "#/$defs/artifact_ref"},
        "media_inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decoded_frame_count", "fps", "duration_seconds", "width", "height", "codec", "pixel_format"],
          "properties": {
            "decoded_frame_count": {"const": 120},
            "fps": {"const": 12},
            "duration_seconds": {"type": "number", "minimum": 9.99, "maximum": 10.01},
            "width": {"const": 880},
            "height": {"const": 600},
            "codec": {"const": "h264"},
            "pixel_format": {"const": "yuv420p"}
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/factual_check"}
        },
        "failures": {
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/workflow_failure"}
        },
        "execution": {"$ref": "#/$defs/execution"}
      }
    },
    "legend_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_field", "label"],
      "properties": {
        "semantic_field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    },
    "presentation_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_stage_index",
        "start_frame",
        "end_frame",
        "title",
        "caption"
      ],
      "properties": {
        "semantic_stage_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "start_frame": {"type": "integer", "minimum": 0, "maximum": 119},
        "end_frame": {"type": "integer", "minimum": 0, "maximum": 119},
        "title": {"type": "string", "minLength": 1, "maxLength": 52},
        "caption": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^[^.!?]+[.!?]$"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "layout_preset", "legend", "stages"],
      "properties": {
        "language": {"const": "en"},
        "layout_preset": {"const": "teaching_overlay_v1"},
        "legend": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/legend_item"}
        },
        "stages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/presentation_stage"}
        }
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false
    },
    "legend_color_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_field",
        "label",
        "source_frame_index",
        "source_frame_id",
        "support_count",
        "exclusive_support_count",
        "sampling_rule",
        "selected_rgb",
        "dominant_count",
        "confidence_ratio"
      ],
      "properties": {
        "semantic_field": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "source_frame_index": {"type": "integer", "minimum": 0, "maximum": 119},
        "source_frame_id": {"type": "string", "pattern": "^frame-[0-9]{6}$"},
        "support_count": {"type": "integer", "minimum": 1},
        "exclusive_support_count": {"type": "integer", "minimum": 0},
        "sampling_rule": {
          "const": "earliest_support_exclusive_else_full_modal_rgb_v1"
        },
        "selected_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "dominant_count": {"type": "integer", "minimum": 1},
        "confidence_ratio": {"type": "number", "minimum": 0.8, "maximum": 1}
      }
    },
    "font_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes", "pixel_size"],
      "properties": {
        "role": {"type": "string", "enum": ["title", "body"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "pixel_size": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "overlay_region_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "bbox", "protected_bbox", "semantic_overlap_pixels"],
      "properties": {
        "region_id": {"type": "string", "enum": ["header", "legend", "caption"]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "protected_bbox": {
          "anyOf": [
            {"$ref": "#/$defs/bbox"},
            {"type": "null"}
          ]
        },
        "semantic_overlap_pixels": {"const": 0}
      }
    },
    "teaching_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "created_at_utc",
        "sequence_manifest",
        "sequence_archive",
        "semantic_contract",
        "presentation",
        "prototype",
        "renderer_adapter",
        "layout",
        "fonts",
        "legend_color_derivation",
        "stage_mapping",
        "frames",
        "contact_sheet",
        "deterministic_replay",
        "media_tools",
        "encoding",
        "teaching_preview",
        "media_inspection",
        "checks",
        "failures",
        "execution"
      ],
      "properties": {
        "schema_version": {"const": "teaching-presentation-1"},
        "artifact_type": {"const": "teaching_manifest"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "sequence_manifest": {"$ref": "#/$defs/artifact_ref"},
        "sequence_archive": {"$ref": "#/$defs/artifact_ref"},
        "semantic_contract": {"$ref": "#/$defs/artifact_ref"},
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "resolved"],
          "properties": {
            "artifact": {"$ref": "#/$defs/artifact_ref"},
