{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/schemas/phase2.schema.json",
  "title": "Live Document Phase 2 Schemas",
  "$comment": "Use schema fragments: #/$defs/plan, #/$defs/probe_result, #/$defs/executor_summary, #/$defs/selection, and #/$defs/executable_spec.",
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "config_scalar": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "semantic_invariant_violation",
        "internal_state_inconsistency",
        "diagnostic_reporting_mismatch",
        "representation_discretization_artifact"
      ]
    },
    "return_target": {
      "type": "string",
      "enum": [
        "candidate_parameters",
        "shared_prototype_implementation",
        "implementation_design",
        "phase1_contract",
        "workflow_runtime_contract"
      ]
    },
    "semantic_state_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "meaning",
        "depends_on",
        "consumers"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "authoritative",
            "derived"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "serialization",
              "semantic_probe",
              "edge_probe",
              "program_probe",
              "diagnostic_metrics",
              "machine_checks",
              "conditioning"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "depends_on": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "depends_on": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "state_invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "claim",
        "fields"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "semantic_state_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "invariants"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/semantic_state_field"
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/state_invariant"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "entity_representations",
        "progress_realization",
        "semantic_state_contract",
        "tunable_parameters",
        "probe_observables",
        "probe_samples",
        "prototype_requirements",
        "known_risks",
        "revision_triggers"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "A concise explanation of the proposed program method. No fixed taxonomy or algorithm-family label is required."
        },
        "entity_representations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity",
              "representation",
              "rationale"
            ],
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1,
                "description": "An entity from the approved Phase 1 contract."
              },
              "representation": {
                "type": "string",
                "minLength": 1,
                "description": "The chosen program representation, such as a curve, graph, region, field, particle set, transform, or another method invented for this concept."
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "Why this representation can preserve the relevant temporal, spatial, and visual constraints."
              }
            }
          }
        },
        "progress_realization": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "progress_variable",
              "calculation",
              "dependencies"
            ],
            "properties": {
              "progress_variable": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "calculation": {
                "type": "string",
                "minLength": 1,
                "description": "How the prototype turns this abstract progress into program state. It may name an algorithm but must not freeze final candidate values."
              },
              "dependencies": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "semantic_state_contract": {
          "$ref": "#/$defs/semantic_state_contract"
        },
        "tunable_parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value_type",
              "purpose"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "value_type": {
                "type": "string",
                "enum": [
                  "integer",
                  "number",
                  "boolean",
                  "categorical"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "description": "What visible or structural property this parameter controls."
              }
            }
          }
        },
        "probe_observables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "probe_samples": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_id",
              "purpose",
              "progress_values"
            ],
            "properties": {
              "sample_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "progress_values": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "prototype_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_driven",
            "deterministic_given_config",
            "shared_core_for_probe_and_full_run"
          ],
          "properties": {
            "config_driven": {
              "const": true
            },
            "deterministic_given_config": {
              "const": true
            },
            "shared_core_for_probe_and_full_run": {
              "const": true
            }
          }
        },
        "known_risks": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision_triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "hypothesis",
        "parameter_overrides"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{3}$"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "description": "Why the varied parameter cannot be fixed directly and what material visible or interpretive consequence is expected."
        },
        "parameter_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/config_scalar"
          },
          "description": "Only values that differ from fixed_parameters."
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_attempt_id",
        "prototype_entrypoint",
        "implementation",
        "candidate_budget",
        "fixed_parameters",
        "candidates"
      ],
      "properties": {
        "implementation_attempt_id": {
          "type": "string",
          "pattern": "^implementation-attempt-[0-9]{3}$"
        },
        "prototype_entrypoint": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the shared parameterized prototype."
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "candidate_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "fixed_parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/config_scalar"
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "machine_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "claim",
        "passed",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "worst_sample_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "state_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "rendered": {
          "type": "boolean"
        },
        "failure_class": {
          "$ref": "#/$defs/failure_class"
        },
        "recommended_return_target": {
          "$ref": "#/$defs/return_target"
        }
      }
    },
    "failure_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "scope",
        "failed_candidate_ids",
        "reported_failure_classes",
        "reported_return_targets"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "shared_across_completed_candidates",
            "candidate_specific",
            "not_comparable"
          ]
        },
        "failed_candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^candidate-[0-9]{3}$"
          }
        },
        "reported_failure_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/failure_class"
          }
        },
        "reported_return_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/return_target"
          }
        }
      }
    },
    "probe_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_attempt_id",
        "candidate_id",
        "complete_config",
        "execution",
        "sampled_states",
        "probe_artifacts",
        "machine_checks",
        "machine_gate_status",
        "failure_summary"
      ],
      "properties": {
        "implementation_attempt_id": {
          "type": "string",
          "pattern": "^implementation-attempt-[0-9]{3}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{3}$"
        },
        "complete_config": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/config_scalar"
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "exit_code",
            "duration_seconds",
            "prototype_sha256",
            "config_sha256"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "exit_code": {
              "type": "integer"
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            },
            "prototype_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "sampled_states": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_id",
              "progress_values",
              "raw_state"
            ],
            "properties": {
              "sample_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "progress_values": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "raw_state": {
                "$ref": "#/$defs/artifact_ref"
              }
            }
          }
        },
        "probe_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_probe",
            "edge_probe",
            "program_probe"
          ],
          "properties": {
            "semantic_probe": {
              "$ref": "#/$defs/artifact_ref"
            },
            "edge_probe": {
              "$ref": "#/$defs/artifact_ref"
            },
            "program_probe": {
              "$ref": "#/$defs/artifact_ref"
            }
          }
        },
        "machine_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/machine_check"
          }
        },
        "machine_gate_status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "failure_summary": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "machine_gate_status": {
                "const": "passed"
              }
            },
            "required": [
              "machine_gate_status"
            ]
          },
          "then": {
            "properties": {
              "failure_summary": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "failure_summary": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "executor_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_attempt_id",
        "candidate_count",
        "completed_probe_results",
        "execution_failures",
        "failure_groups"
      ],
      "properties": {
        "implementation_attempt_id": {
          "type": "string",
          "pattern": "^implementation-attempt-[0-9]{3}$"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "completed_probe_results": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "execution_failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "failure_groups": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/failure_group"
          }
        }
      }
    },
    "reviewed_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "machine_gate_passed",
        "semantic_readability",
        "geometry_fitness",
        "downstream_interpretation_risk",
        "program_readability",
        "decision"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{3}$"
        },
        "machine_gate_passed": {
          "const": true
        },
        "semantic_readability": {
          "type": "string",
          "minLength": 1
        },
        "geometry_fitness": {
          "type": "string",
          "minLength": 1
        },
        "downstream_interpretation_risk": {
          "type": "string",
          "minLength": 1,
          "description": "Whether the edge probe could cause a downstream appearance model to misinterpret the intended semantic geometry."
        },
        "program_readability": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "accept",
            "reject"
          ]
        },
        "rejection_reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_attempt_id",
        "reviewer_type",
        "reviewed_candidates",
        "selection_status"
      ],
      "properties": {
        "implementation_attempt_id": {
          "type": "string",
          "pattern": "^implementation-attempt-[0-9]{3}$"
        },
        "reviewer_type": {
          "type": "string",
          "enum": [
            "human_review",
            "multimodal_agent_review"
          ]
        },
        "reviewed_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/reviewed_candidate"
          }
        },
        "selection_status": {
          "type": "string",
          "enum": [
            "selected",
            "no_selection"
          ]
        },
        "selected_candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{3}$"
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "no_selection_diagnosis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_return": {
          "type": "string",
          "enum": [
            "candidate_plan",
            "implementation_design"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_status": {
                "const": "selected"
              }
            },
            "required": [
              "selection_status"
            ]
          },
          "then": {
            "required": [
              "selected_candidate_id",
              "selection_reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "no_selection_diagnosis"
                  ]
                },
                {
                  "required": [
                    "recommended_return"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "no_selection_diagnosis",
              "recommended_return"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "selected_candidate_id"
                  ]
                },
                {
                  "required": [
                    "selection_reason"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "executable_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_attempt_id",
        "selected_candidate_id",
        "prototype_entrypoint",
        "prototype_sha256",
        "source_probe_result",
        "source_selection",
        "frozen_config",
        "semantic_contract_binding",
        "freeze_checks"
      ],
      "properties": {
        "implementation_attempt_id": {
          "type": "string",
          "pattern": "^implementation-attempt-[0-9]{3}$"
        },
        "selected_candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9]{3}$"
        },
        "prototype_entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "prototype_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_probe_result": {
          "$ref": "#/$defs/artifact_ref"
        },
        "source_selection": {
          "$ref": "#/$defs/artifact_ref"
        },
        "frozen_config": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/config_scalar"
          }
        },
        "semantic_contract_binding": {
          "$ref": "#/$defs/artifact_ref"
        },
        "freeze_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection_matches_candidate",
            "prototype_hash_matches_probe",
            "config_exactly_matches_probe",
            "machine_gate_passed"
          ],
          "properties": {
            "selection_matches_candidate": {
              "const": true
            },
            "prototype_hash_matches_probe": {
