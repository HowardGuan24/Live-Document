        {"beat_id": "mix_clear", "title_zh": "第二阶段：局部颜色扩散并褪去", "caption_zh": "搅拌和扩散消除局部碱性；总体仍偏酸，粉色不能保持。", "progress_start": 0.333333, "progress_end": 0.666667, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "analysis_samples": 161, "attention_metrics": ["plume_integrated_proxy", "indicator_mean_inside_liquid"]},
        {"beat_id": "near_equivalence", "title_zh": "第三阶段：继续滴定，接近当量点", "caption_zh": "酸逐渐被中和，但在越过变色范围前，主体仍接近无色。", "progress_start": 0.666667, "progress_end": 0.94, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "analysis_samples": 161, "attention_metrics": ["base_volume_ml", "bulk_ph"]},
        {"beat_id": "persistent_endpoint", "title_zh": "第四阶段：略过当量点，浅粉保持", "caption_zh": "这一小段化学变化很快，因此时间轴自动放慢，避免一帧突然变红。", "progress_start": 0.94, "progress_end": 1.0, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "analysis_samples": 257, "change_weight": 0.9, "attention_metrics": ["indicator_mean_inside_liquid", "bulk_ph"]}
      ]
