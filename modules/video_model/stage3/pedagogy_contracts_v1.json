    {
      "case_id": "MATH-01",
      "title_zh": "单位圆怎样生成正弦曲线",
      "summary_zh": "跟踪同一个点的纵坐标：圆周点转一圈，右侧依次留下一个完整正弦周期。",
      "provider_module": "modules.video_model.stage2.cases.remaining_programs",
      "source_render_plan": "output/phase-9-scale-motion/MATH-01/state-render-plan.json",
      "beats": [
        {"beat_id": "quarter_1", "title_zh": "第一阶段：从零升到波峰", "caption_zh": "圆周点上升；右侧曲线头保持相同纵坐标。", "progress_start": 0.0, "progress_end": 0.25, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["circle_normalized_y", "trace_fraction"]},
        {"beat_id": "quarter_2", "title_zh": "第二阶段：回到中线", "caption_zh": "圆周点越过最高处，曲线从波峰回到零。", "progress_start": 0.25, "progress_end": 0.5, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["circle_normalized_y", "trace_fraction"]},
        {"beat_id": "quarter_3", "title_zh": "第三阶段：下降到波谷", "caption_zh": "圆周点进入下半圆，曲线同步得到负值。", "progress_start": 0.5, "progress_end": 0.75, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["circle_normalized_y", "trace_fraction"]},
        {"beat_id": "quarter_4", "title_zh": "第四阶段：完成一个周期", "caption_zh": "点回到起始高度，已经发生的轨迹保留为完整正弦曲线。", "progress_start": 0.75, "progress_end": 1.0, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["circle_normalized_y", "trace_fraction"]}
      ]
    },
    {
      "case_id": "MATH-02",
      "title_zh": "勾股定理的拼图重排证明",
      "summary_zh": "四个全等直角三角形不改变面积，只改变摆法；两种空白面积因此相等。",
      "provider_module": "modules.video_model.stage2.cases.sentinel_programs",
      "source_render_plan": "output/phase-10-release/sentinel-motion/MATH-02/state-render-plan.json",
      "beats": [
        {"beat_id": "c_square", "title_zh": "第一阶段：围出 c²", "caption_zh": "四个全等三角形围成中间正方形，它的边长是斜边 c。", "progress_start": 0.0, "progress_end": 0.34, "dynamic_seconds": 2.3, "hold_seconds": 0.8, "attention_metrics": ["progress"]},
        {"beat_id": "rearrange", "title_zh": "第二阶段：只重排，不改面积", "caption_zh": "每个三角形保持全等，外部大正方形面积也不变。", "progress_start": 0.34, "progress_end": 0.66, "dynamic_seconds": 2.3, "hold_seconds": 0.8, "attention_metrics": ["progress"]},
        {"beat_id": "ab_squares", "title_zh": "第三阶段：空白变成 a² 与 b²", "caption_zh": "相同总面积减去相同四个三角形，所以 c² = a² + b²。", "progress_start": 0.66, "progress_end": 1.0, "dynamic_seconds": 2.3, "hold_seconds": 0.8, "attention_metrics": ["progress"]}
      ]
    },
    {
      "case_id": "PHYS-01",
      "title_zh": "两个同步振源产生水面波干涉",
      "summary_zh": "两列同频水波相遇后叠加：同相增强，反相减弱，形成稳定的腹线和节线。",
      "provider_module": "modules.video_model.stage2.cases.sentinel_programs",
      "source_render_plan": "output/phase-10-release/sentinel-motion/PHYS-01/state-render-plan.json",
      "beats": [
        {"beat_id": "emit", "title_zh": "第一阶段：两个振源同步发波", "caption_zh": "两个固定振源以相同频率向外传播圆形波前。", "progress_start": 0.0, "progress_end": 0.25, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["wavefront_radius_px"]},
        {"beat_id": "overlap", "title_zh": "第二阶段：两列波开始重叠", "caption_zh": "同一位置同时收到两列波，位移按叠加原理相加。", "progress_start": 0.25, "progress_end": 0.5, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["overlap_pixel_count"]},
        {"beat_id": "interference", "title_zh": "第三阶段：增强与减弱同时出现", "caption_zh": "同相处振幅更大；反相处彼此抵消。", "progress_start": 0.5, "progress_end": 0.75, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["node_pixel_count", "antinode_pixel_count"]},
        {"beat_id": "pattern", "title_zh": "第四阶段：干涉条纹扩展", "caption_zh": "波继续传播，节线和腹线的空间关系保持稳定。", "progress_start": 0.75, "progress_end": 1.0, "dynamic_seconds": 1.7, "hold_seconds": 0.7, "attention_metrics": ["overlap_pixel_count", "wavefront_radius_px"]}
      ]
    },
    {
      "case_id": "PHYS-02",
      "title_zh": "磁铁运动为什么在线圈中产生感应电流",
      "summary_zh": "电流取决于磁通量是否变化，而不只取决于磁铁离线圈有多近。",
      "provider_module": "modules.video_model.stage2.cases.remaining_programs",
      "source_render_plan": "output/phase-9-scale-motion/PHYS-02/state-render-plan.json",
      "beats": [
        {"beat_id": "approach", "title_zh": "第一阶段：磁铁靠近", "caption_zh": "穿过线圈的磁通增大，电表指针向一个方向偏转。", "progress_start": 0.0, "progress_end": 0.333333, "dynamic_seconds": 2.3, "hold_seconds": 0.8, "attention_metrics": ["magnet_x", "induced_current"]},
        {"beat_id": "stop", "title_zh": "第二阶段：磁铁停住", "caption_zh": "磁铁虽然很近，但磁通不再改变，所以感应电流回到零。", "progress_start": 0.333333, "progress_end": 0.666667, "dynamic_seconds": 2.3, "hold_seconds": 0.8, "attention_metrics": ["magnetic_flux", "induced_current"]},
        {"beat_id": "withdraw", "title_zh": "第三阶段：磁铁撤离", "caption_zh": "磁通减小，电流方向与靠近时相反。", "progress_start": 0.666667, "progress_end": 1.0, "dynamic_seconds": 2.3, "hold_seconds": 0.8, "attention_metrics": ["magnet_x", "induced_current"]}
      ]
    },
    {
      "case_id": "CHEM-01",
      "title_zh": "酸碱滴定从局部变色到终点",
      "summary_zh": "酚酞先在液滴附近短暂变粉，混匀后褪色；略过当量点后浅粉色才持续。",
