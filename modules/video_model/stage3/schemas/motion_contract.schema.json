{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/stage3/motion-contract.schema.json",
  "title": "Stage 3 motion contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "state_timeline",
    "program_video",
    "motion_classes",
    "keyframe_selection",
    "model_input_policy",
    "temporal_gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "state_timeline": {"type": "object"},
    "program_video": {"type": "object"},
    "motion_classes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "keyframe_selection": {"type": "array", "minItems": 2},
    "model_input_policy": {"type": "string", "minLength": 1},
    "temporal_gates": {"type": "array", "minItems": 1}
  }
}
