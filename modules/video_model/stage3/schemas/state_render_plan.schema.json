{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://live-document.local/stage3/state-render-plan.schema.json",
  "title": "Stage 3 deterministic State Renderer B plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "case_id",
    "contract",
    "anchor",
    "keyframe_ids",
    "operators",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "contract": {"type": "string", "minLength": 1},
    "anchor": {
      "type": "object",
      "required": ["path", "preprocess"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "preprocess": {"type": "object"}
      }
    },
    "base_canvas": {"type": "object"},
    "keyframe_ids": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string"}
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operator_id", "operator_type", "config"],
        "properties": {
          "operator_id": {"type": "string"},
          "operator_type": {
            "enum": [
              "region_fill",
              "scalar_transfer",
              "object_material",
              "object_overlay",
              "height_normal",
              "region_material",
              "identity_stroke"
            ]
          },
          "config": {"type": "object"}
        }
      }
    },
    "gates": {"type": "object"}
  }
}
