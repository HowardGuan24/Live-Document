{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2.sequence_spec.schema.json",
  "title": "Stage 2 sequence specification",
  "type": "object",
  "required": [
    "schema_version",
    "sequence_id",
    "case_id",
    "canvas",
    "camera",
    "state_source",
    "keyframes",
    "semantic_layer_ids",
    "fixed_across_sequence_zh",
    "model_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{2}$"
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "coordinate_system"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 64
        },
        "coordinate_system": {
          "const": "pixel_xy_top_left"
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": [
        "view_zh",
        "locked"
      ],
      "properties": {
        "view_zh": {
          "type": "string",
          "minLength": 1
        },
        "locked": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "state_source": {
      "type": "string",
      "minLength": 1
    },
    "keyframes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "keyframe_id",
          "order",
          "state_id",
          "meaning_zh",
          "selection_condition_zh",
          "only_major_change_zh",
          "forbidden_zh"
        ],
        "properties": {
          "keyframe_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "meaning_zh": {
            "type": "string",
            "minLength": 1
          },
          "selection_condition_zh": {
            "type": "string",
            "minLength": 1
          },
          "only_major_change_zh": {
            "type": "string",
            "minLength": 1
          },
          "forbidden_zh": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "semantic_layer_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixed_across_sequence_zh": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_policy": {
      "type": "object",
      "required": [
        "image_model_role_zh",
        "video_model_role_zh",
        "annotations_after_generation"
      ],
      "properties": {
        "image_model_role_zh": {
          "type": "string",
          "minLength": 1
        },
        "video_model_role_zh": {
          "type": "string",
          "minLength": 1
        },
        "annotations_after_generation": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

