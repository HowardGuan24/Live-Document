{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2.semantic_layers.schema.json",
  "title": "Stage 2 semantic-layer manifest",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "state_id",
    "canvas",
    "layers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "state_id": {
      "type": "string"
    },
    "canvas": {
      "type": "object"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "layer_type",
          "title_zh",
          "meaning_zh",
          "source_zh",
          "data",
          "preview",
          "model_input_policy",
          "used_as_model_input",
          "final_role_zh"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "layer_type": {
            "enum": [
              "hard_boundary",
              "region",
              "scalar_field",
              "vector_field",
              "height_or_normal",
              "object_identity",
              "annotation"
            ]
          },
          "title_zh": {
            "type": "string"
          },
          "meaning_zh": {
            "type": "string"
          },
          "source_zh": {
            "type": "string"
          },
          "data": {
            "$ref": "#/$defs/fileRecord"
          },
          "preview": {
            "$ref": "#/$defs/fileRecord"
          },
          "model_input_policy": {
            "enum": [
              "allowed_by_route",
              "never"
            ]
          },
          "used_as_model_input": {
            "type": "boolean"
          },
          "final_role_zh": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "encoding",
        "shape",
        "dtype",
        "value_range"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "encoding": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string"
        },
        "value_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

