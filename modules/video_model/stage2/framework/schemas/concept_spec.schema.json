{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2.concept_spec.schema.json",
  "title": "Stage 2 concept specification",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "title_zh",
    "discipline",
    "learning_goal_zh",
    "assumptions_zh",
    "segments",
    "forbidden_shortcuts_zh"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{2}$"
    },
    "title_zh": {
      "type": "string",
      "minLength": 1
    },
    "discipline": {
      "enum": [
        "mathematics",
        "physics",
        "chemistry",
        "biology",
        "geography"
      ]
    },
    "learning_goal_zh": {
      "type": "string",
      "minLength": 1
    },
    "assumptions_zh": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "order",
          "meaning_zh",
          "mechanism_condition_zh",
          "only_major_change_zh"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "meaning_zh": {
            "type": "string",
            "minLength": 1
          },
          "mechanism_condition_zh": {
            "type": "string",
            "minLength": 1
          },
          "only_major_change_zh": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "forbidden_shortcuts_zh": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

