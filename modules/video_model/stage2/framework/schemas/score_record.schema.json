{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage2.score_record.schema.json",
  "title": "Stage 2 score record",
  "type": "object",
  "required": [
    "protocol_id",
    "subject_id",
    "hard_gates",
    "dimensions",
    "total_points",
    "verdict"
  ],
  "properties": {
    "protocol_id": {
      "const": "stage2_scoring_v1"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "passed",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {}
        },
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rating_0_to_5",
          "weighted_points",
          "evidence",
          "review_zh"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rating_0_to_5": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "weighted_points": {
            "type": "number",
            "minimum": 0
          },
          "evidence": {
            "type": "array"
          },
          "review_zh": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "total_points": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "enum": [
        "promote_to_core_candidate",
        "keep_case_specific",
        "reject",
        "inconclusive"
      ]
    }
  },
  "additionalProperties": false
}

