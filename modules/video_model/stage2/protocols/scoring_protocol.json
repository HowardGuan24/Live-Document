{
  "schema_version": "1.0",
  "protocol_id": "stage2_scoring_v1",
  "rating_scale": {
    "minimum": 0,
    "maximum": 5,
    "anchors": {
      "0": "完全失败或没有证据",
      "1": "严重问题，目标几乎不可用",
      "2": "有部分效果，但主要问题明显",
      "3": "基本可用，仍有清楚可见的不足",
      "4": "质量良好，只有局部不足",
      "5": "达到当前协议定义的目标"
    },
    "points_formula": "dimension_weight * rating / 5"
  },
  "image_and_sequence_dimensions": [
    {
      "id": "mechanism_fidelity",
      "label_zh": "机制忠实度",
      "weight": 25,
      "question_zh": "程序定义的位置、数量、范围、拓扑和先后关系是否正确？"
    },
    {
      "id": "cross_frame_consistency",
      "label_zh": "跨帧一致性",
      "weight": 20,
      "question_zh": "镜头、背景、固定物体、材质尺度和光照是否稳定？"
    },
    {
      "id": "material_improvement",
      "label_zh": "材质提升",
      "weight": 15,
      "question_zh": "与程序底图相比是否更像真实材料，而不是塑料、贴图或刻痕？"
    },
    {
      "id": "teaching_readability",
      "label_zh": "教学可读性",
      "weight": 15,
      "question_zh": "第一次观看的人能否指出本帧发生的主要变化？"
    },
    {
      "id": "artifact_control",
      "label_zh": "伪影控制",
      "weight": 10,
      "question_zh": "是否避免多余物体、文字泄漏、硬描边、结构融化和重复纹理？"
    },
    {
      "id": "seed_robustness",
      "label_zh": "种子稳健性",
      "weight": 10,
      "question_zh": "固定种子组中的多数候选是否有效，而不是只靠一张幸运结果？"
    },
    {
      "id": "reproducibility_and_audit",
      "label_zh": "可复现与可审计",
      "weight": 5,
      "question_zh": "参数、哈希、中间图和选择依据是否齐全？"
    }
  ],
  "video_dimensions": [
    {
      "id": "endpoint_adherence",
      "label_zh": "首尾遵守",
      "weight": 20,
      "question_zh": "第一帧和最后一帧是否忠实于输入？"
    },
    {
      "id": "intermediate_mechanism",
      "label_zh": "中间机制",
      "weight": 25,
      "question_zh": "中间运动是否沿程序允许的路径推进？"
    },
    {
      "id": "temporal_continuity",
      "label_zh": "时间连续性",
      "weight": 20,
      "question_zh": "是否没有闪烁、跳变、倒退和突然出现？"
    },
    {
      "id": "scene_stability",
      "label_zh": "场景稳定性",
      "weight": 15,
      "question_zh": "镜头、背景和固定物体是否不漂移？"
    },
    {
      "id": "motion_naturalness",
      "label_zh": "运动自然度",
      "weight": 10,
      "question_zh": "速度和形变是否可信？"
    },
    {
      "id": "video_teaching_readability",
      "label_zh": "视频教学可读性",
      "weight": 10,
      "question_zh": "过渡是否帮助理解，而不只是视觉变形？"
    }
  ],
  "hard_gates": [
    {
      "id": "file_manifest_integrity",
      "scope": "image_and_video",
      "evidence": "尺寸、模式、哈希和 manifest 对应"
    },
    {
      "id": "case_mechanism_facts",
      "scope": "image_and_video",
      "evidence": "案例 evaluator 验证数量、位置、身份、拓扑和因果顺序"
    },
    {
      "id": "fixed_scene_drift",
      "scope": "image_and_video",
      "evidence": "静态区域差异不超过案例配置阈值"
    },
    {
      "id": "annotation_leakage",
      "scope": "image",
      "evidence": "写实底图不含 UI、图例、箭头、标签或模型生成文字"
    },
    {
      "id": "raw_composite_final_separation",
      "scope": "image",
      "evidence": "模型原图、程序约束结果与最终交付分别保存"
    },
    {
      "id": "prompt_token_integrity",
      "scope": "image_and_video",
      "evidence": "实际 tokenizer 记录证明提示词没有静默截断"
    },
    {
      "id": "model_runtime_identity",
      "scope": "image_and_video",
      "evidence": "模型、权重指纹、精度和运行时与登记配置一致"
    },
    {
      "id": "video_endpoint_identity",
      "scope": "video",
      "evidence": "视频端点与输入关键帧对应且没有换场"
    }
  ],
  "promotion_thresholds": {
    "hard_gates_must_all_pass": true,
    "maximum_regression_points_per_case": 2,
    "minimum_target_dimension_gain_points": 5,
    "minimum_seed_success_fraction": 0.75,
    "minimum_cross_discipline_route_cases": 2,
    "release_requires_all_contract_smokes": true,
    "release_requires_five_discipline_representatives": true
  },
  "stage1_reference_comparison": [
    "材料是否更自然",
    "固定场景是否更稳定",
    "机制变化是否更清楚",
    "模型伪影是否更少"
  ]
}

