# Python caches and local environments
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
README_local.md

# Editors and operating-system metadata
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Build, cache, and temporary directories
build/
dist/
